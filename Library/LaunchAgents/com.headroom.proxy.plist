<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>DO_NOT_TRACK</key>
		<string>1</string>
		<key>HEADROOM_TOOL_SEARCH</key>
		<string>0</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.headroom.proxy</string>
	<key>ProcessType</key>
	<string>Background</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/matt/.local/bin/headroom</string>
		<string>proxy</string>
		<string>--host</string>
		<string>127.0.0.1</string>
		<string>--port</string>
		<string>8787</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/matt/Library/Logs/headroom-proxy.err</string>
	<key>StandardOutPath</key>
	<string>/Users/matt/Library/Logs/headroom-proxy.log</string>
</dict>
</plist>

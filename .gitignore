# Allowlist: everything under $HOME is ignored unless admitted below.
#
# The work tree is all of $HOME and this repo is public, so the default has to
# be "not published" — a blacklist only protects what it thought to name. It
# also keeps untracked walks cheap. See ~/README.md before running any
# whole-tree git command here.
#
# Newly tracked paths need a line below. That surfaces as `macdots add`
# refusing the file, which is the right moment to decide whether it belongs in
# a public repo.
#
# Directories take the un-ignore/re-ignore dance, since git will not descend
# into an excluded directory to find a negation:
#
#     !/.foo/          <- admit the directory itself
#     /.foo/*          <- but not its contents by default
#     !/.foo/bar       <- admit just this

/*
!/.gitignore
!/README.md

# Shell
!/.bash_aliases
!/.bash_profile
!/.bashrc

# Git
!/.gitconfig
!/.gitexcludes
!/.ignore

# Editors, linters, window manager
!/.amethyst.yml
!/.goaccessrc
!/.rubocop.yml
!/.vimrc

# XDG config
!/.config/
/.config/*
!/.config/alacritty/
!/.config/bat/
!/.config/codebook/
!/.config/ghostty/
!/.config/nvim/
!/.config/tmux/
!/.config/worktrunk/
!/.config/zellij/

# rclone
!/.config/rclone/
/.config/rclone/*
!/.config/rclone/exclude.conf

# Toys commands
!/.toys/

# .data is Toys' directory for files a tool reads at runtime. Excluded whole
# rather than gated per file, so anything local stays local by default.
/.toys/.data/

# Scripts on PATH
!/.local/
/.local/*
!/.local/bin/

# Claude Code
!/.claude/
/.claude/*
!/.claude/CLAUDE.md
!/.claude/settings.json
!/.claude/skills/
!/.claude/hooks/

# Codex
!/.codex/
/.codex/*
!/.codex/AGENTS.md
!/.codex/config.toml

# Basic Memory
!/.basic-memory/
/.basic-memory/*
!/.basic-memory/config.json

# Headroom
!/.headroom/
/.headroom/*
!/.headroom/settings.json

# MCP servers
!/.mcp.json
!/Projects/
/Projects/*
!/Projects/.mcp.json
!/Projects/mercury/
/Projects/mercury/*
!/Projects/mercury/.mcp.json

# launchd agents
!/Library/
/Library/*
!/Library/LaunchAgents/
/Library/LaunchAgents/*
!/Library/LaunchAgents/com.headroom.proxy.plist

# Version pins
!/.bundle/
/.bundle/*
!/.bundle/config
!/.nodenv/
/.nodenv/*
!/.nodenv/version
!/.rbenv/
/.rbenv/*
!/.rbenv/version

# Belt and braces
.DS_Store
.env
.env.*
*.key
*.pem

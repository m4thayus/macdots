# Colors and metrics came from .config/alacritty/alacritty.toml and still match
# it. The italic pairing below does not, and cannot: alacritty takes one font
# family with per-style faces, so a second family for italics has no equivalent
# there. Expect the two terminals to differ on comments.

theme = Kanagawa Dragon

# The shipped Kanagawa Dragon inverts foreground and background for selection.
# These are the selection colors Alacritty uses.
selection-background = #2d4f67
selection-foreground = #c8c093

# Alacritty carried these as indexed_colors 16 and 17.
palette = 16=#ffa066
palette = 17=#ff5d62

font-family = Cascadia Code NF
font-style = SemiLight
font-style-bold = SemiBold
font-size = 14

# Hangul, which Cascadia does not cover. D2Coding is the Korean coding standard
# and holds an exact 2:1 Hangul-to-Latin advance width, so the cell grid stays
# aligned through Korean comments and box drawing.
font-family = D2Coding

# Italic comes from Victor Mono for its cursive letterforms. The nvim config sets
# italic on comments and diagnostic virtual text only, and turns it off for
# keywords and builtins, so the cursive lands there and nowhere else.
#
# The style has to be named: Victor Mono ships Italic (cursive) and Oblique
# (slanted roman) as separate faces, and the default would take the wrong one.
# Medium sits right against Cascadia SemiLight. Victor Mono runs light for its
# nominal weight, so the numbers do not line up and the eye is the judge.
font-family-italic = Victor Mono
font-style-italic = Medium Italic

# Bold italic would otherwise fall back to Cascadia and break the pairing
# mid-line. Bold is Victor Mono's heaviest italic, two steps above Medium.
font-family-bold-italic = Victor Mono
font-style-bold-italic = Bold Italic

window-padding-x = 6
window-padding-y = 6
window-padding-balance = true

# Fullscreen and search keep Ghostty's defaults, which are the reverse of the
# Alacritty bindings: cmd+f searches, cmd+ctrl+f goes fullscreen.

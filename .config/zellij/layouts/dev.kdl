// Zellij equivalent of ~/.config/tmux/dev. Launched by dzj; dmux still runs
// the tmux original. The two are kept in step by hand.
//
// One-shots use `bash -lic "<cmd>; exec bash -l"` so the command runs AND the
// pane keeps a live shell — the behaviour send-keys gave us for free.
//
// `zellij action send-keys --pane-id N` does exist, so this is not a gap being
// worked around. It runs against a live session and a known pane id, and a
// layout has neither, which is why the tmux file can use send-keys and this
// one cannot. Reach for it to drive a running session from outside instead.
//
// close_on_exit matches tmux, which has remain-on-exit off by default. Without
// it zellij holds an exited pane open showing [ EXIT CODE: n ], so Ctrl+D
// prints "logout" and then needs a second press to dismiss the corpse.
//
// Long-runners (npm run dev, bin/dev, toys bonsai) get a bare command: they
// never exit, so they never need a shell behind them.

layout {
    // A custom layout replaces zellij's default one wholesale. Without a
    // template there is no tab bar at all.
    default_tab_template {
        children
        pane size=1 borderless=true {
            // zjstatus, because no built-in plugin has a clock. It also drops
            // the swap-layout indicator and the "Zellij" branding that
            // compact-bar prints, so the line reads as tmux's does.
            //
            // Pinned by version deliberately. Upstream's quickstart points at
            // latest/download, and zellij caches a remote plugin per zellij
            // version, so a zellij upgrade would refetch whatever was newest
            // that day with nothing recording the change. Bump this line to
            // upgrade, and expect a permission prompt on first launch.
            plugin location="https://github.com/dj95/zjstatus/releases/download/v0.25.0/zjstatus.wasm" {
                // The three formats are ~/.config/tmux/tmux.conf's status-left,
                // window list and status-right, in that order.
                //
                // Nothing here sets bg, so the bar inherits the terminal the
                // way tmux's `status-style bg=default` does.
                format_left  "#[fg=#c4b28a][{session}]{tabs}"
                format_right "{datetime}"

                // Hex rather than a theme reference: zjstatus paints itself and
                // never reads zellij's theme. Yellow session, green active tab
                // and blue clock are tmux's colours, resolved to Kanagawa
                // Dragon by ~/.config/zellij/themes/kanagawa-dragon.kdl.
                tab_normal "#[fg=#c5c9c5] {index}:{name}"
                tab_active "#[fg=#8a9a7b] {index}:{name}*"

                datetime          "#[fg=#8ba4b0]{format}"
                datetime_format   "%A, %d %b %Y %I:%M %p"
                datetime_timezone "America/New_York"
            }
        }
    }

    tab name="home" focus=true {
        pane split_direction="vertical" {
            pane command="bash" close_on_exit=true {
                args "-lic" "brew update && brew upgrade codex claude-code claude; exec bash -l"
            }
            pane split_direction="horizontal" {
                // vite prints four lines and then sits there, so it is capped.
                // bonsai takes the rest because the tree needs the height.
                pane size="20%" cwd="$MERCURY_BASE_PATH/hg-dev-home" command="npm" close_on_exit=true {
                    args "run" "dev"
                }
                pane command="bash" close_on_exit=true { args "-lic" "toys bonsai"; }
            }
        }
    }

    tab name="talaria" cwd="$MERCURY_BASE_PATH/talaria" {
        pane split_direction="vertical" {
            pane command="bash" close_on_exit=true {
                args "-lic" "toys github prune local; exec bash -l"
            }
            pane command="bin/dev" close_on_exit=true
        }
    }

    tab name="thoth" cwd="$MERCURY_BASE_PATH/thoth" {
        pane command="bash" close_on_exit=true {
            args "-lic" "toys github prune local; exec bash -l"
        }
    }

    tab name="personal" {
        pane split_direction="vertical" {
            pane cwd="$HOME/Projects/phylactery" command="bash" close_on_exit=true {
                args "-lic" "toys github prune local; exec bash -l"
            }
            pane cwd="$HOME/Projects/white-room" command="bash" close_on_exit=true {
                args "-lic" "toys github prune local; exec bash -l"
            }
        }
    }

    tab name="mercury" {
        pane split_direction="vertical" {
            pane cwd="$MERCURY_BASE_PATH"
            pane split_direction="horizontal" {
                pane cwd="$MERCURY_BASE_PATH/livelabs" command="bash" close_on_exit=true {
                    args "-lic" "toys github prune local; exec bash -l"
                }
                pane cwd="$MERCURY_BASE_PATH/psychopomp" command="bash" close_on_exit=true {
                    args "-lic" "toys github prune local; exec bash -l"
                }
            }
        }
    }

    tab name="production" cwd="$HOME" {
        pane
    }
}

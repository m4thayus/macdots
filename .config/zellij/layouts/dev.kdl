// The dev workspace, launched by dzj in ~/.bash_aliases.
//
// One-shots use `sh -c "<cmd>; exec <the shell wrapper>"` so the command runs
// and the pane keeps a live shell behind it. The wrapper is the one
// default_shell names in config.kdl, because these panes want exactly what a
// bare pane wants. default_shell does not reach them: it applies only to a pane
// opened with no command, and every pane here has one. The outer sh only runs a
// command and hands off, so running the wrapper there instead would read
// ~/.bash_profile twice.
//
// A layout cannot use `zellij action send-keys` in place of this. That runs
// against a live session and a known pane id, and a layout has neither. Reach
// for it to drive a running session from outside instead.
//
// close_on_exit matches tmux's default. Without it zellij holds an exited pane
// open showing [ EXIT CODE: n ], so Ctrl+D needs a second press to dismiss the
// corpse.
//
// Long-runners (npm run dev, bin/dev, toys bonsai) get a bare command: they
// never exit, so they never need a shell behind them.

layout {
    // Every layout needs its own copy of this: see default_layout in
    // config.kdl, which also carries the bar's configuration.
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="zjstatus"
        }
    }

    tab name="home" focus=true {
        pane split_direction="vertical" {
            pane size="66%" command="/bin/sh" close_on_exit=true {
                args "-c" "brew update && brew upgrade codex claude-code claude; exec /Users/matt/.config/zellij/shell"
            }
            pane split_direction="horizontal" {
                pane size="33%" command="toys" close_on_exit=true { args "bonsai"; }

                // vite prints four lines and then sits there. The cap has to
                // clear those four plus the frame row, or the pane opens
                // already scrolled.
                pane size="33%" name="hg-dev-home" cwd="$MERCURY_BASE_PATH/hg-dev-home" command="npm" close_on_exit=true {
                    args "run" "dev"
                }

                // Bottom of the column, and cwd is $HOME rather than inherited,
                // because zellij opens a new pane in the focused pane's working
                // directory. A scratch pane split off the bottom of this column
                // is a quick one-off, so it wants $HOME. Every other tab keeps
                // the inherited repo, which is why this is a pane attribute
                // rather than a keybind.
                //
                // --basic drops btm's graphs for htop's table layout. A third
                // of the screen is not enough width for the graphs to read, and
                // btop refused this size outright.
                //
                // --rate is 2s against btm's 1s default. It halves the wakeups,
                // and anything slower reads as jumping between numbers rather
                // than tracking one.
                pane cwd="$HOME" command="btm" close_on_exit=true {
                    args "--basic" "--rate" "2s"
                }
            }
        }
    }

    tab name="talaria" cwd="$MERCURY_BASE_PATH/talaria" {
        pane split_direction="vertical" {
            pane size="66%" command="/bin/sh" close_on_exit=true {
                args "-c" "toys github prune local; exec /Users/matt/.config/zellij/shell"
            }
            pane command="bin/dev" close_on_exit=true
        }
    }

    tab name="thoth" cwd="$MERCURY_BASE_PATH/thoth" {
        pane command="/bin/sh" close_on_exit=true {
            args "-c" "toys github prune local; exec /Users/matt/.config/zellij/shell"
        }
    }

    tab name="personal" {
        pane split_direction="vertical" {
            pane cwd="$HOME/Projects/phylactery" command="/bin/sh" close_on_exit=true {
                args "-c" "toys github prune local; exec /Users/matt/.config/zellij/shell"
            }
            pane cwd="$HOME/Projects/white-room" command="/bin/sh" close_on_exit=true {
                args "-c" "toys github prune local; exec /Users/matt/.config/zellij/shell"
            }
        }
    }

    tab name="mercury" {
        pane split_direction="vertical" {
            pane cwd="$MERCURY_BASE_PATH"
            pane split_direction="horizontal" {
                pane cwd="$MERCURY_BASE_PATH/livelabs" command="/bin/sh" close_on_exit=true {
                    args "-c" "toys github prune local; exec /Users/matt/.config/zellij/shell"
                }
                pane cwd="$MERCURY_BASE_PATH/psychopomp" command="/bin/sh" close_on_exit=true {
                    args "-c" "toys github prune local; exec /Users/matt/.config/zellij/shell"
                }
            }
        }
    }

    tab name="production" cwd="$HOME" {
        pane
    }
}

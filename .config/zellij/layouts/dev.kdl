// The dev workspace, launched by dzj in ~/.bash_aliases.
//
// A pane with no command gets default_shell from config.kdl, which is the
// login-shell wrapper sitting beside it. That wrapper is what runs
// /etc/profile, path_helper, the version managers, direnv and PS1, because
// zellij execs $SHELL plainly where tmux asks for a login shell. So a pane that
// wants a prompt is a bare `pane` and nothing else.
//
// A pane that runs something first and then wants a prompt calls the `run`
// wrapper beside the shell one. It echoes the command line, runs it, and execs
// the login shell. The echo matters because a layout cannot type at a prompt
// the way tmux's send-keys did — `zellij action write-chars` needs a live
// session and a pane id, and a layout has neither.
//
// A pane with a command holds when that command exits, showing [ EXIT CODE: n ]
// and <ENTER> to re-run. Long-runners want that: the pane and its split ratio
// outlive the process, so restarting vite or bin/dev is Ctrl+C then Enter
// rather than a new pane resized by hand.
//
// close_on_exit=true closes the pane instead, which is what a `run` pane wants.
// Its command is the login shell by then, so holding would make Ctrl+D need a
// second press to dismiss the corpse.

layout {
    // Every layout needs its own copy of this: see default_layout in
    // config.kdl, which also carries the bar's configuration.
    default_tab_template {
        children
        pane size=2 borderless=true {
            plugin location="zjstatus"
        }
    }

    tab name="home" focus=true {
        pane split_direction="vertical" {
            pane size="66%" command="/Users/matt/.config/zellij/run" close_on_exit=true {
                args "brew update && brew upgrade codex claude-code claude"
            }
            pane split_direction="horizontal" {
                pane size="33%" command="toys" { args "bonsai"; }

                // vite prints four lines and then sits there. The cap has to
                // clear those four plus the frame row, or the pane opens
                // already scrolled.
                pane size="33%" name="hg-dev-home" cwd="$MERCURY_BASE_PATH/hg-dev-home" command="npm" {
                    args "run" "dev"
                }

                // Bottom of the column, and cwd is $HOME rather than inherited,
                // because zellij opens a new pane in the focused pane's working
                // directory. A scratch pane split off the bottom of this column
                // is a quick one-off, so it wants $HOME. Every other tab keeps
                // the inherited repo, which is why this is a pane attribute
                // rather than a keybind.
                //
                // --basic drops btm's graphs for htop's table layout. A third
                // of the screen is not enough width for the graphs to read, and
                // btop refused this size outright.
                //
                // --rate is 2s against btm's 1s default. It halves the wakeups,
                // and anything slower reads as jumping between numbers rather
                // than tracking one.
                pane cwd="$HOME" command="btm" {
                    args "--basic" "--rate" "2s"
                }
            }
        }
    }

    tab name="talaria" cwd="$MERCURY_BASE_PATH/talaria" {
        pane split_direction="vertical" {
            pane size="66%" command="/Users/matt/.config/zellij/run" close_on_exit=true {
                args "toys github prune local"
            }
            pane command="bin/dev"
        }
    }

    tab name="thoth" cwd="$MERCURY_BASE_PATH/thoth" {
        pane command="/Users/matt/.config/zellij/run" close_on_exit=true {
            args "toys github prune local"
        }
    }

    tab name="personal" {
        pane split_direction="vertical" {
            pane cwd="$HOME/Projects/phylactery" command="/Users/matt/.config/zellij/run" close_on_exit=true {
                args "toys github prune local"
            }
            pane cwd="$HOME/Projects/white-room" command="/Users/matt/.config/zellij/run" close_on_exit=true {
                args "toys github prune local"
            }
        }
    }

    tab name="mercury" {
        pane split_direction="vertical" {
            pane cwd="$MERCURY_BASE_PATH"
            pane split_direction="horizontal" {
                pane cwd="$MERCURY_BASE_PATH/livelabs" command="/Users/matt/.config/zellij/run" close_on_exit=true {
                    args "toys github prune local"
                }
                pane cwd="$MERCURY_BASE_PATH/psychopomp" command="/Users/matt/.config/zellij/run" close_on_exit=true {
                    args "toys github prune local"
                }
            }
        }
    }

    tab name="production" cwd="$HOME" {
        pane
    }
}

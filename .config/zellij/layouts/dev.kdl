// Zellij equivalent of ~/.config/tmux/dev. Launched by dzj; dmux still runs
// the tmux original. The two are kept in step by hand.
//
// One-shots use `sh -c "<cmd>; exec <the shell wrapper>"` so the command runs
// and the pane keeps a live shell, which is the behaviour send-keys gave us
// for free.
//
// The exec'd wrapper is the one default_shell names, because these panes want
// exactly what a bare pane wants. default_shell does not reach them: it
// applies only to a pane opened with no command, and every pane here has one.
//
// The outer sh runs a command and hands off, so it needs no profile of its
// own. Running the wrapper there instead would read ~/.bash_profile twice.
//
// `zellij action send-keys --pane-id N` does exist, so this is not a gap being
// worked around. It runs against a live session and a known pane id, and a
// layout has neither, which is why the tmux file can use send-keys and this
// one cannot. Reach for it to drive a running session from outside instead.
//
// close_on_exit matches tmux, which has remain-on-exit off by default. Without
// it zellij holds an exited pane open showing [ EXIT CODE: n ], so Ctrl+D
// prints "logout" and then needs a second press to dismiss the corpse.
//
// Long-runners (npm run dev, bin/dev, toys bonsai) get a bare command: they
// never exit, so they never need a shell behind them.

layout {
    // Every layout needs its own copy of this: see default_layout in
    // config.kdl, which also carries the bar's configuration.
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="zjstatus"
        }
    }

    tab name="home" focus=true {
        pane split_direction="vertical" {
            pane size="66%" command="/bin/sh" close_on_exit=true {
                args "-c" "brew update && brew upgrade codex claude-code claude; exec /Users/matt/.config/zellij/shell"
            }
            pane split_direction="horizontal" {
                // vite prints four lines and then sits there, so it is capped.
                // The cap has to clear those four plus the frame row, or the
                // pane opens already scrolled. bonsai takes the rest because
                // the tree needs the height.
                pane size="33%" cwd="$MERCURY_BASE_PATH/hg-dev-home" command="npm" close_on_exit=true {
                    args "run" "dev"
                }
                pane command="toys" close_on_exit=true { args "bonsai"; }
            }
        }
    }

    tab name="talaria" cwd="$MERCURY_BASE_PATH/talaria" {
        pane split_direction="vertical" {
            pane size="66%" command="/bin/sh" close_on_exit=true {
                args "-c" "toys github prune local; exec /Users/matt/.config/zellij/shell"
            }
            pane command="bin/dev" close_on_exit=true
        }
    }

    tab name="thoth" cwd="$MERCURY_BASE_PATH/thoth" {
        pane command="/bin/sh" close_on_exit=true {
            args "-c" "toys github prune local; exec /Users/matt/.config/zellij/shell"
        }
    }

    tab name="personal" {
        pane split_direction="vertical" {
            pane cwd="$HOME/Projects/phylactery" command="/bin/sh" close_on_exit=true {
                args "-c" "toys github prune local; exec /Users/matt/.config/zellij/shell"
            }
            pane cwd="$HOME/Projects/white-room" command="/bin/sh" close_on_exit=true {
                args "-c" "toys github prune local; exec /Users/matt/.config/zellij/shell"
            }
        }
    }

    tab name="mercury" {
        pane split_direction="vertical" {
            pane cwd="$MERCURY_BASE_PATH"
            pane split_direction="horizontal" {
                pane cwd="$MERCURY_BASE_PATH/livelabs" command="/bin/sh" close_on_exit=true {
                    args "-c" "toys github prune local; exec /Users/matt/.config/zellij/shell"
                }
                pane cwd="$MERCURY_BASE_PATH/psychopomp" command="/bin/sh" close_on_exit=true {
                    args "-c" "toys github prune local; exec /Users/matt/.config/zellij/shell"
                }
            }
        }
    }

    tab name="production" cwd="$HOME" {
        pane
    }
}

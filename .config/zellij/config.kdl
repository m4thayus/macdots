//
// ~/.config/zellij/config.kdl
//
// Overrides only. Everything unlisted comes from zellij's built-in defaults.
//
// This file used to be a full `zellij setup --dump-config`. That pins the
// defaults of whatever version dumped it, so upgrades stop landing: the dump
// predated 0.45.1 and was overriding its ScrollToPreviousPrompt/NextPrompt
// binds back out. Keep this file to things that actually differ.

// Matches ~/.config/ghostty/config and the nvim colorscheme.
theme "kanagawa-dragon"

// tmux runs with `set -g mouse on`; keep the two consistent.
mouse_mode true

// zellij execs $SHELL directly for new panes, where tmux creates a login
// shell. Without this, a pane opened by hand has no version-manager shims,
// no direnv and no PS1. See the comment in the wrapper.
default_shell "/Users/matt/.config/zellij/shell"

// Drop the powerline chevrons. They are the bulk of what makes zellij's chrome
// read as louder than tmux's single status line.
simplified_ui true

// A deliberate break from tmux, which draws a bare divider and no pane titles.
// The title names the command the pane is running, and that is worth the row
// and two columns a frame costs. themes/kanagawa-dragon.kdl colours them.
pane_frames true

// zellij serializes a session when it exits and resurrects it on the next
// attach, with every command suspended behind a "Waiting to run" prompt. That
// makes `dzj` restore yesterday's closed tabs instead of building the layout,
// and tmux has no equivalent behaviour. The dev workspace is meant to be built
// fresh each morning, so turn it off rather than work around it in the alias.
session_serialization false

// A layout replaces zellij's default one wholesale, so anything a session
// needs has to be in the layout that built it. That trapped the status bar in
// dev.kdl and left a bare `zellij` on the stock tab-bar and status-bar.
// plain.kdl is the minimal carrier: one pane plus the template.
default_layout "plain"

// The bar itself lives here, as a plugin alias, so the layouts reference it by
// name and only state it once. A user `plugins` block merges with zellij's
// built-in aliases rather than replacing them.
//
// zjstatus, because no built-in plugin has a clock. It also drops the
// swap-layout indicator compact-bar prints, so the line reads as tmux's does.
//
// The "Zellij" branding is put back by hand. Nothing needs it, but the bar has
// the room and the maintainers earned the credit. It takes the clock's blue so
// it reads as chrome, and not as part of the session and tab list beside it.
//
// Pinned by version deliberately. Upstream's quickstart points at
// latest/download, and zellij caches a remote plugin per zellij version, so a
// zellij upgrade would refetch whatever was newest that day with nothing
// recording the change. Bump this line to upgrade, and expect a permission
// prompt on first launch.
plugins {
    zjstatus location="https://github.com/dj95/zjstatus/releases/download/v0.25.0/zjstatus.wasm" {
        // The three formats are ~/.config/tmux/tmux.conf's status-left, window
        // list and status-right, in that order.
        //
        // Nothing here sets bg, so the bar inherits the terminal the way
        // tmux's `status-style bg=default` does.
        format_left  "#[fg=#8ba4b0]Zellij {mode}#[fg=#c4b28a][{session}]{tabs}"
        format_right "{datetime}"

        // Hex rather than a theme reference: zjstatus paints itself and never
        // reads zellij's theme. Yellow session, green active tab and blue clock
        // are tmux's colours, resolved to Kanagawa Dragon by
        // ~/.config/zellij/themes/kanagawa-dragon.kdl.
        tab_normal "#[fg=#c5c9c5] {index}:{name}"
        tab_active "#[fg=#8a9a7b] {index}:{name}*"

        datetime          "#[fg=#8ba4b0]{format}"
        datetime_format   "%A, %d %b %Y %I:%M %p"
        datetime_timezone "America/New_York"

        // tmux shows no prefix indicator, and does not need one: the prefix
        // lasts a single keystroke. A zellij mode is sticky until Esc, so it is
        // a state you can sit in without noticing, and it gets a marker.
        //
        // It reads far left, after the branding and before the session, which is
        // where both nvim and zellij's own default bar put the mode.
        //
        // The two colours are the two frame colours, so the bar and the border a
        // pane is wearing never say different things. Base mode takes the
        // focused-frame yellow, any other mode takes frame_highlight's orange.
        //
        // Red is deliberately left alone: exit_code_error owns it, and a mode is
        // a state you chose rather than something that went wrong.
        //
        // zjstatus has no key for "every mode except normal", so one real mode
        // has to carry that format and mode_default_to_mode points the rest at
        // it. tmux is the carrier because it is the one reached by hand, which
        // makes the line true on its own terms rather than only as a template.
        //
        // A clearer invented key is not available, and would fail silently.
        // zjstatus matches the key suffix and mode_default_to_mode against a
        // fixed list of fourteen mode names, drops anything else without an
        // error, and falls back to painting every mode with mode_normal.
        //
        // {name} is zellij's own mode name. Literal text in its place would cost
        // a line per mode, because only the placeholder survives the fallback.
        mode_normal          "#[fg=#c8c093]{name} "
        mode_tmux            "#[fg=#ffa066]{name} "
        mode_default_to_mode "tmux"
    }
}

// tmux's prefix, ported. zellij ships a Tmux mode whose binds all end in
// SwitchToMode "Normal", which is exactly what a prefix does, so the modality
// helps here rather than getting in the way.
//
// Only the prefix moves. tmux's non-prefix binds are deliberately not ported:
// Ctrl h, Ctrl p and Ctrl n are zellij's Move, Pane and Resize mode keys, and
// Alt h/j/k/l already focuses panes.
//
// `prefix r` has no equivalent. zellij has no reload action because it watches
// this file and reloads on write.
keybinds {
    tmux {
        // Matches ~/.config/tmux/tmux.conf: v splits right, h splits down.
        // Both displace zellij's own tmux-mode meanings for these keys.
        bind "v" { NewPane "Right"; SwitchToMode "Normal"; }
        bind "h" { NewPane "Down"; SwitchToMode "Normal"; }

        // Tab mode's only other door, now that Ctrl t is unbound below.
        bind "t" { SwitchToMode "Tab"; }

        // prefix prefix sends the prefix through, the way tmux's own
        // `bind C-\\ send-prefix` does. 28 is Ctrl \, which is what the
        // overmind session running inside a zellij pane listens for.
        // Without this zellij swallows the key and the nested tmux never
        // sees a prefix.
        //
        // This passes one keystroke. Ctrl g locks zellij outright when the
        // nested session needs a run of them.
        bind "Ctrl \\" { Write 28; SwitchToMode "Normal"; }
    }
    shared_except "tmux" "locked" {
        bind "Ctrl \\" { SwitchToMode "Tmux"; }

        // tmux unbinds Ctrl b for the reason this does: it is readline's
        // backward-char, so a multiplexer holding it breaks that in every pane.
        unbind "Ctrl b"

        // Ctrl t is fzf's file widget. zellij held it for Tab mode, so fzf
        // never saw it. Tab mode's own keys are redundant here anyway: prefix
        // c, n, p and , already cover new, next, previous and rename.
        unbind "Ctrl t"
    }
}

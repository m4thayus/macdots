//
// ~/.config/zellij/config.kdl
//
// Overrides only. Everything unlisted comes from zellij's built-in defaults.
// Never paste in a `zellij setup --dump-config`: it pins the defaults of the
// version that dumped it, so later upgrades silently stop landing.

// Matches ~/.config/ghostty/config and the nvim colorscheme.
theme "kanagawa-dragon"

// tmux runs with `set -g mouse on`. Keep the two consistent.
mouse_mode true

// zellij execs $SHELL directly for new panes, where tmux creates a login
// shell. Without this, a pane opened by hand has no version-manager shims,
// no direnv and no PS1. See the comment in the wrapper.
default_shell "/Users/matt/.config/zellij/shell"

// No simplified_ui line. The flag is a signal zellij passes to plugins, and
// pane frames are core rendering rather than a plugin, so the built-in bar was
// the only thing reading it. zjstatus replaced that bar and ignores the flag,
// which leaves nothing for either value to change.

// A deliberate break from tmux, which draws a bare divider and no pane titles.
// The title names the command the pane is running, and that is worth the row
// and two columns a frame costs. themes/kanagawa-dragon.kdl colours them.
pane_frames true

// zellij serializes a session when it exits and resurrects it on the next
// attach, with every command suspended behind a "Waiting to run" prompt. That
// makes `dzj` restore yesterday's closed tabs instead of building the layout,
// and tmux has no equivalent behaviour. The dev workspace is meant to be built
// fresh each morning, so turn it off rather than work around it in the alias.
session_serialization false

// A layout replaces zellij's default one wholesale, so anything a session needs
// has to be in the layout that built it. plain.kdl is the minimal carrier that
// gives a bare `zellij` the same bar: one pane plus the template.
default_layout "plain"

// The bar itself lives here, as a plugin alias, so the layouts reference it by
// name and only state it once. A user `plugins` block merges with zellij's
// built-in aliases rather than replacing them.
//
// zjstatus, because no built-in plugin has a clock. It also drops the
// swap-layout indicator compact-bar prints, so the line reads as tmux's does.
//
// The "Zellij" branding is put back by hand. Nothing needs it, but the bar has
// the room and the maintainers earned the credit. It takes the clock's blue so
// it reads as chrome, and not as part of the session and tab list beside it.
//
// Pinned by version deliberately. Upstream's quickstart points at
// latest/download, and zellij caches a remote plugin per zellij version, so a
// zellij upgrade would refetch whatever was newest that day with nothing
// recording the change. Bump this line to upgrade, and expect a permission
// prompt on first launch.
plugins {
    zjstatus location="https://github.com/dj95/zjstatus/releases/download/v0.25.0/zjstatus.wasm" {
        // The three formats are ~/.config/tmux/tmux.conf's status-left, window
        // list and status-right, in that order.
        //
        // Branding, mode and clock are filled blocks. Each marks something that
        // changes, or something you have to check: which multiplexer this is,
        // which mode is open, what time it is. The session name is fixed for
        // the life of the session, so it holds no fill and no colour of its
        // own — it sits on the right as bracketed text, which is the shape
        // tmux's status-left gave it.
        //
        // The tab list stays bare too: it is the segment that changes width as
        // you work, and a block on each tab would move the bar's right edge
        // every time you open one.
        //
        // The bar's own fill is #393836, dragonBlack5, so the bar reads as its
        // own surface rather than as terminal background. format_space carries
        // the same fill into the gap between the tab list and the clock.
        //
        // frame_unselected — #625e5a, the idle pane border — is the colour that
        // would tie the bar to the frames, and it is too light to carry the tab
        // list. It puts the green active tab at 2.1:1 against it, and that
        // marker is the one thing in the list you have to be able to pick out.
        // One step down the same ramp takes the green to 3.9:1 and the plain
        // tab text to 7.0:1.
        //
        // A chevron is a solid triangle, not a blend: it takes the fill it
        // leaves as its fg and the fill it enters as its bg. So it vanishes
        // wherever two fills sit at the same luminance, and Kanagawa Dragon is
        // flat by design — every hue in it lands between L 0.30 and L 0.35.
        // Branding into mode is one of those seams, at 1.15:1, and it is a
        // straight edge here because a chevron there would cost a column to
        // draw nothing. Both surviving chevrons cross into the bar fill, where
        // the ratio is about 4:1. The one leaving the mode block lives in the
        // mode formats below, because the mode fill changes and a chevron in
        // this string could not follow it.
        //
        // The glyphs are U+E0B0 and U+E0B2, which need a patched font.
        // ~/.config/ghostty/config sets Cascadia Code NF, and NF is the patch.
        format_left  "#[fg=#181616,bg=#8ba4b0,bold] Zellij {mode}#[fg=#c5c9c5,bg=#393836]{tabs}"
        format_right "#[fg=#b6927b,bg=#393836][{session}] {datetime}"
        format_space "#[bg=#393836]"

        // Hex rather than a theme reference: zjstatus paints itself and never
        // reads zellij's theme. The values resolve to Kanagawa Dragon through
        // ~/.config/zellij/themes/kanagawa-dragon.kdl.
        //
        // The active tab takes the yellow, the same colour as the focused frame,
        // so one hue reads as "here" in the bar and in the frames.
        //
        // The Dragon orange #b6927b is the louder alternative and is deliberately
        // not used. Nothing else in this palette claims that hue, so it does mark
        // the tab more sharply. Sharper is still wrong here. Yellow is usually
        // already on screen in ordinary output, so an orange tab reads as a
        // second signal rather than as the marker on the first.
        //
        // The cost is that yellow is palette slot 7, the ANSI white that ordinary
        // output lands on. It runs 6.37:1 against the bar fill where the inactive
        // tabs run 6.99:1, so luminance separates the two almost not at all. The
        // hue and the trailing asterisk carry the signal, and the asterisk is
        // what carries it if the colour fails to.
        //
        // SYNC: ~/.config/zellij/themes/kanagawa-dragon.kdl paints frame_selected
        // this same yellow. Change one and change the other, or the tab and the
        // frame stop agreeing about which pane is focused.
        //
        // The session name takes the orange the tab list does not want. As text
        // rather than a fill it reads as a label, not as a marker, so the hue's
        // loudness costs nothing there.
        //
        // SYNC: ~/.config/tmux/tmux.conf paints its own session name this same
        // orange, so an embedded session labels itself the way this one does.
        tab_normal "#[fg=#c5c9c5,bg=#393836] {index}:{name}"
        tab_active "#[fg=#c8c093,bg=#393836] {index}:{name}*"

        datetime          "#[fg=#8ba4b0,bg=#393836]#[fg=#181616,bg=#8ba4b0,bold] {format} "
        datetime_format   "%A, %d %b %Y %I:%M %p"
        datetime_timezone "America/New_York"

        // A zellij mode is sticky until Esc, so it is a state you can sit in
        // without noticing. tmux needs no such marker: its prefix lasts one
        // keystroke.
        //
        // SYNC: magenta is frame_highlight in themes/kanagawa-dragon.kdl, the
        // colour the focused frame takes while a mode is open. The block and
        // the border report one state, so change them together.
        //
        // Normal mode is the resting state and takes green.
        //
        // zjstatus has no key for "every mode except normal", so one real mode
        // carries that format and mode_default_to_mode points the rest at it.
        // Both names have to come from zjstatus's fixed list of fourteen modes.
        // An invented key is dropped without an error, and every mode then falls
        // back to mode_normal.
        mode_normal          "#[fg=#181616,bg=#8a9a7b,bold] {name} #[fg=#8a9a7b,bg=#393836]"
        mode_tmux            "#[fg=#181616,bg=#a292a3,bold] {name} #[fg=#a292a3,bg=#393836]"
        mode_default_to_mode "tmux"
    }
}

// tmux's prefix, ported. zellij ships a Tmux mode whose binds all end in
// SwitchToMode "Normal", which is exactly what a prefix does, so the modality
// helps here rather than getting in the way.
//
// Only the prefix moves. tmux's non-prefix binds are deliberately not ported:
// Ctrl h, Ctrl p and Ctrl n are zellij's Move, Pane and Resize mode keys, and
// Alt h/j/k/l already focuses panes.
//
// `prefix r` has no equivalent. zellij has no reload action because it watches
// this file and reloads on write.
keybinds {
    tmux {
        // Matches ~/.config/tmux/tmux.conf: v splits right, h splits down.
        // Both displace zellij's own tmux-mode meanings for these keys.
        bind "v" { NewPane "Right"; SwitchToMode "Normal"; }
        bind "h" { NewPane "Down"; SwitchToMode "Normal"; }

        // Tab mode's other door. Ctrl t is unbound below.
        bind "t" { SwitchToMode "Tab"; }

        // prefix prefix sends the prefix through, the way tmux's own
        // `bind C-\\ send-prefix` does. 28 is Ctrl \, which is what the
        // overmind session running inside a zellij pane listens for.
        // Without this zellij swallows the key and the nested tmux never
        // sees a prefix.
        //
        // This passes one keystroke. Ctrl g locks zellij outright when the
        // nested session needs a run of them.
        bind "Ctrl \\" { Write 28; SwitchToMode "Normal"; }
    }
    shared_except "tmux" "locked" {
        bind "Ctrl \\" { SwitchToMode "Tmux"; }

        // tmux unbinds Ctrl b for the reason this does: it is readline's
        // backward-char, so a multiplexer holding it breaks that in every pane.
        unbind "Ctrl b"

        // Ctrl t is fzf's file widget. zellij held it for Tab mode, so fzf
        // never saw it. Tab mode's own keys are redundant here anyway: prefix
        // c, n, p and , already cover new, next, previous and rename.
        unbind "Ctrl t"
    }
}

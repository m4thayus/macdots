# Mirrored by ~/.config/zellij/layouts/dev.kdl, which dzj launches.
new -s dev -n home
# 66/33 left-to-right. -l sizes the new (right) pane.
splitw -h -l 33%
# -b puts vite above bonsai, and it renumbers the panes: bonsai is 2, not 1.
splitw -v -b -l 20% -c "$MERCURY_BASE_PATH/hg-dev-home" "npm run dev"
send-keys -t 2 'toys bonsai' Enter
send-keys -t 0 'brew update && brew upgrade codex claude-code claude' Enter
new-window -n talaria -c "$MERCURY_BASE_PATH/talaria"
splitw -h -l 33% -c "$MERCURY_BASE_PATH/talaria" "bin/dev"
send-keys -t 0 'toys github prune local' Enter
new-window -n thoth -c "$MERCURY_BASE_PATH/thoth"
send-keys 'toys github prune local' Enter
new-window -n personal -c "$HOME/Projects/phylactery"
splitw -h -c "$HOME/Projects/white-room"
send-keys -t 0 'toys github prune local' Enter
send-keys -t 1 'toys github prune local' Enter
new-window -n mercury -c "$HOME/Projects/mercury"
splitw -h -c "$MERCURY_BASE_PATH/livelabs"
splitw -v -c "$MERCURY_BASE_PATH/psychopomp"
send-keys -t 1 'toys github prune local' Enter
send-keys -t 2 'toys github prune local' Enter
new-window -n production -c "$HOME"
selectw -t 0

